%% 1) GEOMETRY, STEEL MASS, LEVEL-VOLUME CURVE ===========================
Ri = Ro - t_wall;  h_head = head_k*Ri;
V_cyl = pi*Ri^2*L_cyl;  V_head = (2/3)*pi*Ri^2*h_head;
V  = V_cyl + 2*V_head;                                   % internal volume [m3]
a = Ro; c = head_k*Ro;
if abs(c - a) < 1e-9
  A_head = 2*pi*a^2;
else
  e = sqrt(1 - c^2/a^2);
  A_head = pi*a^2 + pi*c^2/(2*e)*log((1+e)/(1-e));
end
A_out   = 2*pi*Ro*L_cyl + 2*A_head;                      % outer surface inner vessel [m2]
m_steel = rho_ss*A_out*t_wall + m_extra;                 % steel that must be chilled [kg]

% Liquid height vs volume (horizontal tank). Both heads together = one spheroid.
hgt   = linspace(0, 2*Ri, 400);
A_seg = Ri^2*acos((Ri-hgt)/Ri) - (Ri-hgt).*sqrt(max(2*Ri*hgt - hgt.^2, 0));
fracV_of_h = (L_cyl*A_seg + (4/3)*pi*Ri^2*h_head*(hgt.^2.*(3*Ri-hgt))/(4*Ri^3)) / V;

