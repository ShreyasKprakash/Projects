%% ====================== LOCAL FUNCTIONS ================================
function pb = p_back(md, rho_n, VH, patm)
% vent-header back-pressure: turbulent dp ~ rho_n * Q^2, scaled from R&I reference values
Q  = md/rho_n*3600;                                  % [Nm3/h]
pb = patm + (rho_n/VH.rho_ref)*(VH.dp40*(Q/VH.Q40)^2 + VH.dp80*(Q/VH.Q80)^2);
end

function md = vent_flow(CdA, pu, Tu, G, VH, patm, dpc)
% flow from tank into the vent header. The header back-pressure rises with the flow,
% so solve  md = orifice(pu -> p_back(md) + dpc)  by bisection. dpc = check-valve cracking pressure.
if nargin < 7, dpc = 0; end
lo = 0;  hi = orifice(CdA, pu, Tu, patm + dpc, G.g, G.R);
for it = 1:50
  mid = 0.5*(lo + hi);
  if orifice(CdA, pu, Tu, p_back(mid, G.rho_n, VH, patm) + dpc, G.g, G.R) > mid, lo = mid; else, hi = mid; end
end
md = 0.5*(lo + hi);
end

function n = purge_cycles(c0, ct, r)
% dilution cycles so that c0*r^n <= ct
n = max(0, ceil(log(ct/c0)/log(r)));
end

function md = orifice(CdA, pu, Tu, pd, g, R)
% compressible ideal-gas orifice flow [kg/s]; pr = max(pd/pu, critical) covers choked + subsonic
if pu <= pd, md = 0; return; end
pcr = (2/(g+1))^(g/(g-1));
pr  = max(pd/pu, pcr);
md  = CdA*pu*sqrt(2*g/((g-1)*R*Tu)*max(pr^(2/g) - pr^((g+1)/g), 0));
end

function f = liq_frac(rho, p, sat)
% liquid VOLUME fraction of a saturated mix with average density rho
f = (rho - sat('rv',p))/(sat('rl',p) - sat('rv',p));
end

function u = u_mix(rho, p, sat)
% specific internal energy of a saturated mix with average density rho at pressure p
x = (1/rho - 1/sat('rl',p))/(1/sat('rv',p) - 1/sat('rl',p));
u = sat('ul',p) + x*(sat('uv',p) - sat('ul',p));
end

function p = p_from_rho_u(rho, u, S)
% pressure at which a saturated mix of density rho has specific energy u
x  = (1/rho - 1./S.rl)./(1./S.rv - 1./S.rl);
ok = x >= 0 & x <= 1;
if nnz(ok) < 2, p = NaN; return; end
um = S.ul(ok) + x(ok).*(S.uv(ok) - S.ul(ok));
pp = S.p(ok);
[um, ix] = sort(um);
p = interp1(um, pp(ix), u, 'linear', NaN);
end

function D = read_eu_csv(file)
% read EU-CSV (';' separator, ',' decimal); first line = header; numeric columns
fid = fopen(file, 'r');  hdr = fgetl(fid);  body = fread(fid, '*char')';  fclose(fid);
names = strsplit(strtrim(hdr), ';');
body  = strrep(body, ',', '.');
C = textscan(body, repmat('%f', 1, numel(names)), 'Delimiter', ';', 'CollectOutput', true);
X = C{1};
for k = 1:numel(names), D.(fn(names{k})) = X(:,k); end
end

function f = fn(name)
% turn a CSV column name into a valid field name ("T [K]" -> "T__K_")
f = regexprep(strtrim(name), '[^A-Za-z0-9_]', '_');
if isempty(f) || ~isletter(f(1)), f = ['x' f]; end
end

function s = ternary(c, a, b)
if c, s = a; else, s = b; end
end

function chk(cond, msg)
if cond, fprintf('  [PASS] %s\n', msg); else, fprintf('  [FAIL] %s\n', msg); end
end

function s = okstr(c)
if c, s = 'OK'; else, s = 'NOT OK'; end
end

function p = p_needed(md, Tu, G, CdA, VH, patm, dpc)
% tank pressure needed to push mass flow md through the boil-off path (CdA + check valve) (bisection)
if nargin < 7, dpc = 0; end
lo = patm;  hi = 50e5;
if vent_flow(CdA, hi, Tu, G, VH, patm, dpc) < md, p = Inf; return; end
for it = 1:60
  mid = 0.5*(lo + hi);
  if vent_flow(CdA, mid, Tu, G, VH, patm, dpc) < md, lo = mid; else, hi = mid; end
end
p = hi;
end
