%% 3) PRESSURE LEVELS & BURST (structural) ================================
% Burst = shell failure (uses Rm): thin-wall, Faupel thick-wall, 2:1 head.
% Allowable PS (EN 13445 style): f = min(Rp/1.5, Rm/2.4); PS = 2 f z t/(De - t)
Di = 2*Ri;  De = 2*Ro;
pb_thin   = Rm*t_wall/Ri;
pb_faupel = (2/sqrt(3))*Rp02*(2 - Rp02/Rm)*log(Ro/Ri);
pb_head   = 2*Rm*t_wall/(Di + 0.2*t_wall);
p_burst_g = min([pb_thin pb_faupel pb_head]);
f_allow   = min(Rp02/1.5, Rm/2.4);
PS_shell_g = min(2*f_allow*z_weld*t_wall/(De - t_wall), 2*f_allow*z_weld*t_wall/(Di + 0.2*t_wall));
PS_g      = min(PS_shell_g, PS_comp_g);
PT_g      = 1.43*PS_g;                                  % PED hydrostatic test pressure
E_gas     = @(p) p*V/(N2.g-1)*(1 - (patm/p)^((N2.g-1)/N2.g));   % stored energy if gas-filled

