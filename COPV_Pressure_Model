  pm_in = min(max(pm, S.p(1)), S.p(end));
  tag = ''; if is_demo, tag = ' [DEMO DATA]'; end
  tm  = linspace(0, max(th), 200);  lm = max(fill_frac*(1 - (tm - t_fill_h)*3600/t_empty), 0);
  figure(8); clf; set(gcf,'Name','Fig 8 measured vs model','Color','w');
  subplot(3,1,1); plot(th, (pm-patm)*1e3/1e5, 'LineWidth',1.0); hold on; grid on;
  plot(th([1 end]), p_alarm_g*1e3/1e5*[1 1], 'm:');
  xlim([0 max(th)]); ylabel('p [mbar g]'); legend('measured','alarm (vent blocked)','Location','east');
  title(['Fig 8a - tank pressure with vent open' tag]);
  subplot(3,1,2); plot(th, TL, th, TV, th, sat('T', pm_in), 'k--', 'LineWidth',1.2); grid on;
  xlim([0 max(th)]); ylabel('T [K]'); ylim([15 40]);   % cryogenic range - remove for warm phases
  legend('T liquid sensor','T vapour sensor','T_{sat}(p measured)','Location','east');
  title(['Fig 8b - sensors vs boiling temperature' tag]);
  if isfield(D, fn(col_dp))
    dpm = D.(fn(col_dp))*dp_unit;
    hm  = dpm./((sat('rl',pm_in) - sat('rv',pm_in))*9.81);
    lvm = interp1(hgt, fracV_of_h, min(max(hm,0), 2*Ri));
    subplot(3,1,3); plot(th, 100*lvm, tm, 100*lm, '--', 'LineWidth',1.2); grid on;
    xlim([0 max(th)]); ylabel('liquid [%]'); xlabel('t [h]'); legend('from dTRANS','model','Location','northeast');
    title(['Fig 8c - liquid level from dTRANS vs model' tag]);
    if all(~isnan(win_boiloff_h))
      w   = th >= win_boiloff_h(1) & th <= win_boiloff_h(2);
      mLm = lvm(w).*V.*sat('rl',pm_in(w));
      c1  = polyfit(th(w)*3600, mLm, 1);               % slope [kg/s]
      Q_eff = -c1(1)*(sat('hv',mean(pm_in(w))) - sat('hl',mean(pm_in(w))));
      fprintf('Heat leak from level drop %.0f-%.0f h: %.2f W (model %.2f W, ratio %.2f)\n', ...
              win_boiloff_h(1), win_boiloff_h(2), Q_eff, Q_leak, Q_eff/Q_leak);
      fprintf('  -> put this value in Q_leak_override and rerun: all predictions are then calibrated\n');
    end
  end
  if all(~isnan(win_leak_h))
    i1 = find(th >= win_leak_h(1), 1);  i2 = find(th >= win_leak_h(2), 1);
    dts = (th(i2)-th(i1))*3600;
    fprintf('He hold leak: raw %.3f, T-compensated %.3f mbar*L/s (detection limit ~%.2f)\n', ...
            10*V*(pm(i1)-pm(i2))/dts, 10*V*(pm(i1)/TV(i1) - pm(i2)/TV(i2))*T_room/dts, max(Q_min_p, Q_min_T));
  end
  fprintf('\n');
else
  fprintf('=== 12) No measured data file set (data_file) - skipped ===\n\n');
end

