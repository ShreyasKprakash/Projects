fprintf('Pressure purge alternative (boil-off valve cycled, %.0f bar g): %d cycles for O2, %d for N2\n', (p_purge_high-patm)/1e5, n_O2, n_N2);
fprintf('Sweep needs He inlet and vent outlet far apart; dead legs (sensor ports, dTRANS lines) purge worse -> O2 analyser at the vent\n');
fprintf('Leak test (boil-off valve closed, %.0f bar g): pressure hold sees leaks > %.2f mbar*L/s (resolution) / %.2f (%.1f K drift) -> He sniffer below\n\n', ...
        p_leaktest_g/1e5, Q_min_p, Q_min_T, dT_res);
figure(2); clf; set(gcf,'Name','Fig 2 purge','Color','w');
Nv = linspace(0, max(N_O2, N_N2)+1, 200);
semilogy(Nv, 0.21*exp(-Nv)*1e6, Nv, 1.0*exp(-Nv)*1e6, '--', 'LineWidth',1.5); hold on; grid on;
plot(Nv([1 end]), 1e6*c_target_O2*[1 1], 'r:', Nv([1 end]), 1e6*c_target_N2*[1 1], 'k:');
xlabel('tank volumes of He flushed through'); ylabel('impurity [ppm]');
legend('O_2 (air in tank)','N_2 (after LN_2 drain)','O_2 target','N_2 target');
title('Fig 2 - He sweep purge through the tank (boil-off valve open)');

%% 5) PHASE B/C/D - CHILLDOWN ============================================
% Heat in the steel: dH = m * integral(cp dT). Cryogen used lies between
%   worst: latent heat only (cold gas leaves unused)
%   best : gas also warms up to the steel temperature before leaving
TT = [20 30 40 50 60 77 100 125 150 175 200 250 293.15];
cp = [12 27 58 98 136 195 255 305 345 375 400 440 475];       % 304/316 SS approx [J/kgK]
H_ss = @(T) interp1(TT, cumtrapz(TT, cp), T);
hfg_H2 = sat('hv',p_fill) - sat('hl',p_fill);
dH_B = m_steel*(H_ss(T_room) - H_ss(N2_Tsat));
dH_D = m_steel*(H_ss(N2_Tsat) - H_ss(20.3));
dH_X = m_steel*(H_ss(T_room) - H_ss(20.3));
mLN2  = dH_B ./ [N2_hfg, N2_hfg + N2_cpg*(T_room - N2_Tsat)];     % [worst best]
mLH2  = dH_D ./ [hfg_H2, hfg_H2 + H2_cpg*(N2_Tsat - 20.3)];
mLH2x = dH_X ./ [hfg_H2, hfg_H2 + H2_cpg*(T_room - 20.3)];
fprintf('=== 5) CHILLDOWN (steel %.0f kg) ===\n', m_steel);
fprintf('B  LN2 293->77 K : %.2f MJ -> %.1f-%.1f kg LN2\n', dH_B/1e6, mLN2(2), mLN2(1));
fprintf('C  after LN2 drain: He sweep of %.1f tank volumes to N2 < %.0f ppm (section 4)\n', N_N2, 1e6*c_target_N2);
fprintf('D  LH2 77->20 K  : %.2f MJ -> %.2f-%.2f kg LH2 (without LN2 pre-cool: %.1f-%.1f kg)\n\n', ...
        dH_D/1e6, mLH2(2), mLH2(1), mLH2x(2), mLH2x(1));
figure(3); clf; set(gcf,'Name','Fig 3 chilldown','Color','w');
subplot(1,2,1); Tp = linspace(20.3, T_room, 200);
plot(Tp, m_steel*H_ss(Tp)/1e6, 'LineWidth',1.5); hold on; grid on;
plot([N2_Tsat N2_Tsat], [0 m_steel*H_ss(T_room)/1e6], 'k--');
xlabel('steel temperature [K]'); ylabel('heat to remove [MJ]'); title('Fig 3a - heat stored in the steel');
subplot(1,2,2);
bar([mLN2; mLH2; mLH2x]); set(gca,'XTickLabel',{'LN2 293-77','LH2 77-20','LH2 293-20'});
ylabel('cryogen [kg]'); grid on; legend('worst (latent only)','best (cold gas used)');
title('Fig 3b - cryogen needed');

%% 6) PHASE D - LH2 CAPACITY + FILL HEIGHT ================================
% Worst moment = vent blocked and safety valves relieving. Liquid must still be <= 95 % then.
% Same mass at fill (closed tank) -> allowed fill level at 1 atm.
rho_max = fill_max_at_relief*sat('rl',p_rel) + (1-fill_max_at_relief)*sat('rv',p_rel);
rho_lim = rho_max;                                       % safety limit density
if isnan(fill_target)
  rho0 = rho_max;
else
  rho0 = fill_target*sat('rl',p_fill) + (1-fill_target)*sat('rv',p_fill);
  if rho0 > rho_max, fprintf('WARNING: fill_target above safety limit -> limited\n'); rho0 = rho_max; end
end
m0 = rho0*V;   if ~isnan(m_fill_meas), m0 = m_fill_meas; rho0 = m0/V; end
f_lim = liq_frac(rho_lim, p_fill, sat);
fill_frac = liq_frac(rho0, p_fill, sat);
h_fill = interp1(fracV_of_h, hgt, fill_frac);
fprintf('=== 6) LH2 CAPACITY ===\n');
fprintf('100 %% liquid would be %.2f kg (not allowed); safety limit %.1f %% = %.2f kg\n', sat('rl',p_fill)*V, 100*f_lim, rho_lim*V);
fprintf('Planned fill %.2f kg = %.1f %% liquid (%.1f L) + %.1f L gas space | liquid height %.0f of %.0f mm\n', ...
        m0, 100*fill_frac, 1e3*fill_frac*V, 1e3*(1-fill_frac)*V, 1e3*h_fill, 2e3*Ri);
fprintf('Liquid expands %.1f %% between 1 atm and safety-valve relieving pressure\n', 100*(sat('rl',p_fill)/sat('rl',p_rel) - 1));
g0 = 9.81;
dp_LH2 = (sat('rl',p_fill) - sat('rv',p_fill))*g0*h_fill;
dp_LN2 = (N2_rhoL - 4.6)*g0*h_fill;
fprintf('dTRANS level signal at this fill: LH2 %.2f mbar | LN2 %.1f mbar (same height) -> check dTRANS range/accuracy!\n\n', ...
        dp_LH2/100, dp_LN2/100);
figure(4); clf; set(gcf,'Name','Fig 4 fill level','Color','w');
plot(100*fracV_of_h, 1e3*hgt, 'LineWidth',1.5); hold on; grid on;
plot(100*fill_frac, 1e3*h_fill, 'ro', 'MarkerFaceColor','r');
plot(100*f_lim, 1e3*interp1(fracV_of_h, hgt, f_lim), 'ks', 'MarkerFaceColor','k');
xlabel('liquid volume [%]'); ylabel('liquid height from bottom [mm]');
legend('horizontal tank','planned fill','safety limit','Location','northwest');
title('Fig 4 - fill level: volume vs liquid height');

%% 7) HEAT LEAK - BUILT UP FROM THE DRAWING ==============================
% Radiation (MLI or bare), conduction through every penetration, supports, wires, sight glasses.
eps_eff = 1/(1/eps_in + 1/eps_out - 1);
Q_rad   = sigma*eps_eff*A_out*(T_room^4 - 20.3^4);           % bare vacuum gap
Q_ins   = ternary(use_MLI, q_MLI*A_out, Q_rad);
Q_pen   = zeros(size(PEN,1),1);
for k = 1:size(PEN,1)
  OD = PEN{k,3}/1e3;  w = PEN{k,4}/1e3;
  Q_pen(k) = PEN{k,2}*kint_SS*pi*(OD - w)*w/PEN{k,5};
end
Q_sg    = n_sightglass*pi/4*0.063^2*sigma*T_room^4*eps_in;    % room radiation through DN63 windows
Q_cond  = sum(Q_pen) + Q_supports + Q_wires + Q_sg;
Q_leak  = Q_ins + Q_cond;
Q_est   = Q_leak;                                              % estimate from the drawing
p_spec  = p_spec_g + patm;
Q_spec  = boiloff_spec_gph/3.6e6*(sat('hv',p_spec) - sat('hl',p_spec))/(1 - sat('rv',p_spec)/sat('rl',p_spec));
if use_spec_boiloff, Q_leak = Q_spec; end
if ~isnan(Q_leak_override), Q_leak = Q_leak_override; end
fprintf('=== 7) HEAT LEAK FROM THE DRAWING ===\n');
fprintf('   %-34s %7s\n', 'path', 'Q [W]');
fprintf('   %-34s %7.2f  (%s)\n', ternary(use_MLI,'MLI blanket','bare vacuum radiation'), Q_ins, ternary(use_MLI,sprintf('%.1f W/m2',q_MLI),'no MLI'));
for k = 1:size(PEN,1), fprintf('   %-34s %7.2f\n', PEN{k,1}, Q_pen(k)); end
fprintf('   %-34s %7.2f\n   %-34s %7.2f\n   %-34s %7.2f\n', 'supports (placeholder)', Q_supports, 'sensor wires', Q_wires, 'sight glasses', Q_sg);
fprintf('   %-34s %7.2f W   (without MLI it would be %.1f W)\n', 'TOTAL from drawing', Q_est, Q_rad + Q_cond);
fprintf('-> Heat leak: drawing estimate %.2f W | spec %.0f g/h at %.1f bar g = %.2f W | USED %.2f W\n', ...
        Q_est, boiloff_spec_gph, p_spec_g/1e5, Q_spec, Q_leak);
fprintf('\n');
figure(10); clf; set(gcf,'Name','Fig 10 heat-leak breakdown','Color','w');
qb = [Q_ins; Q_pen; Q_supports; Q_wires];
nb = [{ternary(use_MLI,'MLI','radiation (bare)')}; PEN(:,1); {'supports'}; {'wires'}];
barh(qb); set(gca,'YTick',1:numel(qb),'YTickLabel',nb); grid on; xlabel('heat leak [W]');
title(sprintf('Fig 10 - drawing estimate %.1f W (model uses %.2f W)', Q_est, Q_leak));

% LH2 fill time through the 1/4" line (single-phase liquid = FASTEST possible; flashing makes it slower)
A_fl  = pi/4*ID_fill^2;  rhoL = sat('rl',p_fill);  f_D = 0.02;
v_fl  = sqrt(2*dp_fill/(rhoL*(f_D*L_fill/ID_fill + K_fill)));
md_fl = rhoL*A_fl*v_fl;
fprintf('LH2 fill through 1/4" line at %.2f bar dp: <= %.1f g/s -> %.2f kg in >= %.0f min (two-phase flow: expect 2-5x longer)\n\n', ...
        dp_fill/1e5, 1e3*md_fl, m0, m0/md_fl/60);

%% 8) BOIL-OFF CONTROLLED BY THE BOIL-OFF VALVE ============================
% 8a) Model check against the HYDROS 250 datasheet (calibrates closed-tank times)
Vh = 0.266;  mh = 13.7;  rh = mh/Vh;  p12 = 1.2e5 + patm;  p6 = 6e5 + patm;
Qh = 0.011/3600*(sat('hv',p12) - sat('hl',p12))/(1 - sat('rv',p12)/sat('rl',p12));
th = mh*(u_mix(rh, p6, sat) - u_mix(rh, p12, sat))/Qh;
k_strat = th/3600/32;                                  % real pressure rise is this much faster
r202 = 0.202/Vh*sat('rl',p_fill) + (1 - 0.202/Vh)*sat('rv',p_fill);
fprintf('=== 8a) HYDROS 250 CHECK ===\n');
fprintf('Fill rule: 202 L of 266 L -> %.1f %% liquid at 6 bar g (our rule 95 %%) -> confirmed\n', 100*liq_frac(r202, p6, sat));
fprintf('Heat leak from 11 g/h: %.2f W | closed-tank pressure rise: model %.0f h vs datasheet 32 h -> real is %.1fx faster\n\n', Qh, th/3600, k_strat);

% 8b) Normal operation. After filling the boil-off valve is closed, the heat leak
%     raises the pressure (lock-up). At p_bov_open the control system opens the
%     valve, gas leaves through valve + check valve into the header, the liquid
%     flashes and the pressure drops to p_bov_close, the valve closes again.
%   closed: U = U + Q dt                        open: U = U + Q dt - mdot h_v dt, m = m - mdot dt
A_BOV = Cd_vent*A_v;
m = m0;  U = m0*u_mix(rho0, p_fill, sat);
t = 0;  is_open = false;  n_open = 0;  vented = 0;  istep = 0;  t_lock = NaN;
dt_closed = 30;  dt_open = 2e-3;
N = 2e6;  tv = zeros(N,1); pv = tv; lv = tv; mv = tv; k = 1;
pv(1) = p_fill; lv(1) = fill_frac;
while t < 30*86400 && k < N
  rho = m/V;
  p = p_from_rho_u(rho, U/m, S);
  if isnan(p), fprintf('state left table range - stop\n'); break; end
  lf = liq_frac(rho, p, sat);
  if lf < 0.02, break; end
  if ~is_open && p >= p_bov
    is_open = true;  n_open = n_open + 1;
    if isnan(t_lock), t_lock = t; end
  elseif is_open && p <= p_bovc
    is_open = false;
  end
  if is_open
    dt = dt_open;  md = vent_flow(A_BOV, p, sat('T',p), Gc, VH, patm, dp_crack);
  else
    dt = dt_closed;  md = 0;
  end
  U = U + Q_leak*dt - md*sat('hv',p)*dt;
  m = m - md*dt;  vented = vented + md*dt;  t = t + dt;  istep = istep + 1;
  if ~is_open || mod(istep,50) == 0
    k = k + 1; tv(k) = t; pv(k) = p; lv(k) = lf; mv(k) = vented;
  end
end
tv = tv(1:k); pv = pv(1:k); lv = lv(1:k); mv = mv(1:k);  t_empty = t;
t_cycle = (t_empty - t_lock)/max(n_open,1);
hfg_op  = sat('hv',p_bov) - sat('hl',p_bov);
md_bo   = Q_leak/hfg_op*(1 - sat('rv',p_bov)/sat('rl',p_bov));
fprintf('=== 8b) BOIL-OFF via %s (opens %.1f / closes %.1f bar g, check valve %.0f mbar) ===\n', ...
        ternary(strcmp(vent_type,'relief'),'SPRING RELIEF VALVE (self-acting)','ACTUATED BOIL-OFF VALVE'), ...
        p_bov_open_g/1e5, p_bov_close_g/1e5, dp_crack/100);
if p_bov_open_g > 0.9*MEOP_g
  fprintf('  [WARN] boil-off opens at %.1f bar g = too close to the tank SVs (%.1f): the SVs become the working valve\n', p_bov_open_g/1e5, MEOP_g/1e5);
end
fprintf('Lock-up 1 atm -> %.1f bar g: %.1f h model (~%.1f h realistic)\n', p_bov_open_g/1e5, t_lock/3600, t_lock/3600/k_strat);
fprintf('Boil-off valve opens %d times, about every %.1f h | average boil-off %.0f g/h | LH2 gone after %.1f days\n', ...
        n_open, t_cycle/3600, 3.6e6*md_bo, t_empty/86400);
fprintf('LH2 stored at %.1f K (saturation at %.1f bar g)\n\n', sat('T',p_bov), p_bov_open_g/1e5);

% 8c) Boil-off valve STUCK CLOSED (or line iced): closed tank from operating pressure
u_op    = u_mix(rho0, p_bov, sat);
t_alarm = m0*(u_mix(rho0, p_alarm_g+patm, sat) - u_op)/Q_leak;
t_MEOPc = m0*(u_mix(rho0, p_MEOP, sat) - u_op)/Q_leak;
p_PS    = min(PS_g + patm, S.p(end));
t_PSc   = m0*(u_mix(rho0, p_PS, sat) - u_op)/Q_leak;
fprintf('=== 8c) BOIL-OFF VALVE STUCK CLOSED at %.1f W ===\n', Q_leak);
fprintf('Alarm (%.1f bar g): %.1f h model / ~%.1f h realistic | safety valves (%.1f bar g): %.1f h / ~%.1f h\n', ...
        p_alarm_g/1e5, t_alarm/3600, t_alarm/3600/k_strat, MEOP_g/1e5, t_MEOPc/3600, t_MEOPc/3600/k_strat);
if has_SV
  fprintf('-> the %d tank safety valves open at MEOP and vent to the header (sized in section 11)\n', n_SV);
else
  fprintf('-> NO safety valves: tank limit PS reached after %.1f h / ~%.1f h unless someone opens a vent\n', t_PSc/3600, t_PSc/3600/k_strat);
end
fprintf('Liquid at MEOP: %.0f %% of the tank (limit %.0f %%)\n\n', 100*liq_frac(rho0, p_MEOP, sat), 100*fill_max_at_relief);

figure(5); clf; set(gcf,'Name','Fig 5 controlled boil-off','Color','w');
subplot(3,1,1); plot(tv/3600, (pv-patm)/1e5, 'LineWidth',1.0); hold on; grid on;
plot(tv([1 end])/3600, p_bov_open_g/1e5*[1 1], 'm--', tv([1 end])/3600, p_alarm_g/1e5*[1 1], 'k:', tv([1 end])/3600, MEOP_g/1e5*[1 1], 'r--');
ylim([0 1.1*MEOP_g/1e5]); ylabel('p [bar g]');
legend('tank','boil-off valve opens','alarm','tank safety valves','Location','northwest');
title('Fig 5 - lock-up, then the boil-off valve holds the operating pressure');
subplot(3,1,2); plot(tv/3600, 100*lv, 'LineWidth',1.2); grid on; ylabel('liquid [%]');
subplot(3,1,3); plot(tv/3600, mv, 'LineWidth',1.2); grid on; ylabel('GH2 vented [kg]'); xlabel('t [h]');

figure(9); clf; set(gcf,'Name','Fig 9 heat-leak sensitivity','Color','w');
loglog(Q_sweep, t_lock*Q_leak./Q_sweep/3600, 'o-', Q_sweep, t_empty*Q_leak./Q_sweep/3600, 's-', ...
       Q_sweep, t_cycle*Q_leak./Q_sweep/3600, '^-', Q_sweep, t_MEOPc*Q_leak./Q_sweep/3600/k_strat, 'd--', 'LineWidth',1.5); grid on;
xlabel('heat leak Q [W]'); ylabel('time [h]');
legend('lock-up to operating pressure','LH2 gone','time between valve openings','valve stuck: to MEOP (realistic)');
title('Fig 9 - all times scale with 1/heat leak');

%% 9) DEPRESSURISATION: power failure (actuated, fail-open) or manual vent (relief)
% The boil-off valve is fail-open: without power it opens. The tank at operating
% pressure depressurises through valve + check valve to ~1 atm. The energy to boil
% comes from the liquid itself -> it cools from T_sat(p_op) to 20.3 K and part flashes.
mf = m0;  Uf = m0*u_op;  pf = p_bov;  dt = 1e-3;  tfl = 0;  pfl9 = p_bov;  k = 1;
p_end = patm + dp_crack + 200;
while pf > p_end && k < 1e6
  md = vent_flow(A_BOV, pf, sat('T',pf), Gc, VH, patm, dp_crack);
  if md <= 0, break; end
  Uf = Uf - sat('hv',pf)*md*dt;  mf = mf - md*dt;
  pf = p_from_rho_u(mf/V, Uf/mf, S);  if isnan(pf), break; end
  k = k + 1;  tfl(k) = tfl(k-1) + dt;  pfl9(k) = pf;
end
m_flash = m0 - mf;
fprintf('=== 9) DEPRESSURISATION to ~1 atm from %.1f bar g (%s) ===\n', p_bov_open_g/1e5, ...
        ternary(strcmp(vent_type,'relief'),'operator opens the manual vent valve - spring valves need no power','power failure: boil-off valve fails open'));
fprintf('Tank vents to ~1 atm in %.1f s | %.2f kg flashes off (%.0f %%) | liquid cools %.1f K -> %.1f K\n', ...
        tfl(end), m_flash, 100*m_flash/m0, sat('T',p_bov), sat('T',pf));
fprintf('-> safe state (tank at ~1 atm, vent open), but plan for this mass going up the chimney at once\n\n');
figure(11); clf; set(gcf,'Name','Fig 11 power failure','Color','w');
plot(tfl, (pfl9-patm)/1e5, 'LineWidth',1.5); grid on; xlabel('t [s]'); ylabel('p [bar g]');
title(sprintf('Fig 11 - venting the tank to 1 atm: %.0f %% of the LH2 flashes', 100*m_flash/m0));

%% 10) He LEAK TEST ON THE WARM TANK: PRESSURISATION + BLOWDOWN =========
% Boil-off valve closed, He from the SVE line through the quick coupling to 4 bar g.
% Afterwards the boil-off valve opens and the tank blows down through valve + check valve.
% Tank energy (open system):  m cv dT/dt = mdot_in (cp T_in - cv T) - mdot_out R T + Q
G  = GAS.(ops_gas);  dt = 0.02;
mt = patm*V/(G.R*T_room); Tt = T_room;  tp = 0; pt_ = patm; Tp_ = Tt; k = 1;
while tp(k) < 3600
  md = min(orifice(CdA_QC(ops_gas), min(p_test, G.p_line), T_room, pt_(k), G.g, G.R), G.md_line);
  Tt = Tt + dt*(md*(G.cp*T_room - G.cv*Tt) + h_wall*A_out*(T_room - Tt))/(mt*G.cv);
  mt = mt + dt*md;  k = k + 1;
  tp(k) = tp(k-1) + dt;  pt_(k) = mt*G.R*Tt/V;  Tp_(k) = Tt;
  if pt_(k) >= 0.99*p_test + 0.01*patm, break; end
end
dt = 0.002;  T = Tt;  mg = mt;  tb = 0; pb = pt_(end); k = 1;
while pb(k) > patm + dp_crack + 500 && k < 1e6
  md = vent_flow(Cd_vent*A_v, pb(k), T, G, VH, patm, dp_crack);
  T  = T + dt*(-md*G.R*T + h_wall*A_out*(T_room - T))/(mg*G.cv);
  mg = mg - dt*md;  k = k + 1;
  tb(k) = tb(k-1) + dt;  pb(k) = mg*G.R*T/V;
end
fprintf('=== 10) %s LEAK TEST (warm tank, boil-off valve closed) ===\n', ops_gas);
fprintf('Pressurise 0 -> %.0f bar g via quick coupling (Cv %.1f): %.0f s, gas heats to %.0f K (no heat exchange)\n', p_leaktest_g/1e5, Cv_QC.(ops_gas), tp(end), max(Tp_));
fprintf('Cooling back to room T: pressure falls to ~%.2f bar g WITHOUT any leak -> wait for stable T, compare p/T\n', ...
        (pt_(end)*T_room/Tp_(end) - patm)/1e5);
fprintf('Boil-off valve opened: blowdown through valve + check valve in %.1f s\n\n', tb(end));
figure(6); clf; set(gcf,'Name','Fig 6 leak-test pressurisation','Color','w');
subplot(2,1,1); plot(tp, (pt_-patm)/1e5, 'LineWidth',1.5); grid on; ylabel('p [bar g]');
title(sprintf('Fig 6 - %s leak test: filling to %.0f bar g (boil-off valve closed)', ops_gas, p_leaktest_g/1e5));
subplot(2,1,2); plot(tp, Tp_, 'LineWidth',1.5); grid on; ylabel('T_{gas} [K]'); xlabel('t [s]');

%% 11) BOIL-OFF PATH CAPACITY + TANK SAFETY VALVES (no burst disc) =========
% Cases: (a) loss of insulating vacuum with LH2 inside (cold GH2)
%        (b) tank-panel regulator fails open: SVE regulator max flow into the tank
% Q1: with the boil-off valve OPEN, can valve + check valve carry the flow (what tank pressure)?
% Q2: with the boil-off path CLOSED/blocked, each tank safety valve must carry it alone at <= 1.1 x MEOP.
fprintf('=== 11) BOIL-OFF PATH + TANK SAFETY VALVES ===\n');
chk(max([p_line_g.H2 p_line_g.He p_line_g.N2]) <= PS_g, ...
    sprintf('supply line pressure (%.0f bar g) <= tank PS (%.1f bar g)', max([p_line_g.H2 p_line_g.He p_line_g.N2])/1e5, PS_g/1e5));
fprintf('   -> if FAIL: panel pressure reducer + safety valves sized for full regulator flow are mandatory\n');
hfgR   = sat('hv',p_rel) - sat('hl',p_rel);
md_LOV = q_LOV*A_out/hfgR*(1 - sat('rv',p_rel)/sat('rl',p_rel));
cases  = {'(a) loss of vacuum, cold GH2', md_LOV, sat('T',p_rel), Gc};
for gn = {'H2','He','N2'}
  Gg = GAS.(gn{1});  md_in = Gg.md_reg;
  if fail_use_restriction, md_in = min(md_in, orifice(CdA_QC(gn{1}), Gg.p_line, T_room, p_rel, Gg.g, Gg.R)); end
  cases(end+1,:) = {sprintf('(b) regulator open, %s', gn{1}), md_in, T_room, Gg};
end
A_case = zeros(1, size(cases,1));  p_open = A_case;
fprintf('   case                              flow [g/s]  [Nm3/h]  valve open: tank p [bar g]  valve shut: SV d [mm]\n');
for k = 1:size(cases,1)
  md = cases{k,2};  Tu = cases{k,3};  Gk = cases{k,4};
  p_open(k) = p_needed(md, Tu, Gk, Cd_vent*A_v, VH, patm, dp_crack);
  pbk = p_back(md, Gk.rho_n, VH, patm);
  A_case(k) = md/(Kd_SV*orifice(1, p_rel, Tu, pbk, Gk.g, Gk.R));
  fprintf('   %-33s %9.1f %8.0f %20.2f %20.1f\n', cases{k,1}, 1e3*md, md/Gk.rho_n*3600, (p_open(k)-patm)/1e5, 1e3*sqrt(4*A_case(k)/pi));
end
[A_req, kgov] = max(A_case);  d_SV_req = sqrt(4*A_req/pi);
chk(max(p_open) - patm < MEOP_g, 'open boil-off path alone keeps every case below MEOP');
if has_SV
  fprintf('Each of the %d tank safety valves needs flow diameter >= %.1f mm (boil-off path shut, governed by %s); installed %.1f mm -> %s\n', ...
          n_SV, 1e3*d_SV_req, cases{kgov,1}, 1e3*d_SV, okstr(d_SV >= d_SV_req));
else
  fprintf('[WARN] NO tank safety valves: if the boil-off path is shut nothing relieves pressure. A relief device would need >= %.1f mm (%s)\n', ...
          1e3*d_SV_req, cases{kgov,1});
end
rho_air = patm/(287*T_room);  rho_cold = sat('rv',patm);  rho_exit = patm/(H2_R*T_stack_exit);
fprintf('Chimney: fresh GH2 %.2f kg/m3 vs air %.2f -> heavier than air until it warms; at %.0f K exit %.3f kg/m3\n', ...
        rho_cold, rho_air, T_stack_exit, rho_exit);
fprintf('Check valves on every line into the shared header stop backflow and air from reaching the cold tank\n');
fprintf('Vacuum jacket: an inner-tank leak pressurises the flat-walled box (2) - the lid resting on its FKM seal acts as its relief; keep it free to lift\n');
% Failure simulation: boil-off path SHUT + panel regulator fails open (governing gas), one tank safety valve.
[~, kb] = max(A_case(2:end));  Gf = cases{kb+1,4};  md_in = cases{kb+1,2};  gname = cases{kb+1,1};
A_SVuse = has_SV*max(A_SV, A_req);
mt = p_bov*V/(Gf.R*T_room); Tt = T_room;  dt = 1e-3;  tf = 0; pfl = p_bov; k = 1; sv_open = false;
while tf(k) < 30
  pk = mt*Gf.R*Tt/V;
  if pk >= p_MEOP, sv_open = true; end
  if sv_open && pk < 0.9*MEOP_g + patm, sv_open = false; end
  mo = sv_open*vent_flow(Kd_SV*A_SVuse, pk, Tt, Gf, VH, patm);
  mi = md_in*(pk < Gf.p_line);                      % inflow stops at supply line pressure
  Tt = Tt + dt*(mi*(Gf.cp*T_room - Gf.cv*Tt) - mo*Gf.R*Tt + h_wall*A_out*(T_room - Tt))/(mt*Gf.cv);
  mt = mt + dt*(mi - mo);  k = k + 1;
  tf(k) = tf(k-1) + dt;  pfl(k) = mt*Gf.R*Tt/V;
end
i_PS = find(pfl - patm > PS_g, 1);
if isempty(i_PS)
  fprintf('Boil-off path shut + %s: peak %.2f bar g (limit %.2f, PS %.2f) -> OK\n\n', gname, (max(pfl)-patm)/1e5, 1.1*MEOP_g/1e5, PS_g/1e5);
else
  fprintf('Boil-off path shut + %s, no relief: PS (%.1f bar g) exceeded after %.1f s, tank heads to the supply line pressure -> NOT OK\n\n', ...
          gname, PS_g/1e5, tf(i_PS));
end
figure(7); clf; set(gcf,'Name','Fig 7 blocked vent + regulator failure','Color','w');
plot(tf, (pfl-patm)/1e5, 'LineWidth',1.5); hold on; grid on;
plot(tf([1 end]), MEOP_g/1e5*[1 1], 'r--', tf([1 end]), PS_g/1e5*[1 1], 'k--', 'LineWidth',1.2);
ylim([0 1.15*max(PS_g, max(pfl)-patm)/1e5]); xlabel('t [s]'); ylabel('p [bar g]');
legend('tank','MEOP = safety valve set','PS (tank limit)','Location','southeast');
if has_SV
  title(sprintf('Fig 7 - boil-off path SHUT and %s: one tank safety valve d = %.1f mm', strrep(gname,'(b) ',''), 1e3*sqrt(4*A_SVuse/pi)));
else
