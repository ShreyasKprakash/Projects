# ====================== FUNCTIONS (local functions in MATLAB) =============
def p_back(md, rho_n, VH, patm):
    """vent-header back-pressure: turbulent dp ~ rho_n * Q^2, scaled from R&I reference values"""
    Q = md / rho_n * 3600.0                                  # [Nm3/h]
    return patm + (rho_n / VH['rho_ref']) * (VH['dp40'] * (Q / VH['Q40'])**2 + VH['dp80'] * (Q / VH['Q80'])**2)


def orifice(CdA, pu, Tu, pd, g, R):
    """compressible ideal-gas orifice flow [kg/s]; pr = max(pd/pu, critical) covers choked + subsonic"""
    if pu <= pd:
        return 0.0
    pcr = (2.0 / (g + 1.0))**(g / (g - 1.0))
    pr = max(pd / pu, pcr)
    return CdA * pu * math.sqrt(2.0 * g / ((g - 1.0) * R * Tu) * max(pr**(2.0 / g) - pr**((g + 1.0) / g), 0.0))


def vent_flow(CdA, pu, Tu, G, VH, patm, dpc=0.0):
    """flow from tank into the vent header; solve md = orifice(pu -> p_back(md) + dpc) by bisection.
    dpc = check-valve cracking pressure."""
    lo = 0.0
    hi = orifice(CdA, pu, Tu, patm + dpc, G['g'], G['R'])
    for _ in range(50):
        mid = 0.5 * (lo + hi)
        if orifice(CdA, pu, Tu, p_back(mid, G['rho_n'], VH, patm) + dpc, G['g'], G['R']) > mid:
            lo = mid
        else:
            hi = mid
    return 0.5 * (lo + hi)


def p_needed(md, Tu, G, CdA, VH, patm, dpc=0.0):
    """tank pressure needed to push mass flow md through the boil-off path (CdA + check valve) (bisection)"""
    lo, hi = patm, 50e5
    if vent_flow(CdA, hi, Tu, G, VH, patm, dpc) < md:
        return math.inf
    for _ in range(60):
        mid = 0.5 * (lo + hi)
        if vent_flow(CdA, mid, Tu, G, VH, patm, dpc) < md:
            lo = mid
        else:
            hi = mid
    return hi


def purge_cycles(c0, ct, r):
    """dilution cycles so that c0*r^n <= ct"""
    return max(0, math.ceil(math.log(ct / c0) / math.log(r)))


def interp1(x, y, xq):
    """MATLAB interp1 (linear): NaN outside the data range"""
    return np.interp(xq, x, y, left=np.nan, right=np.nan)


def liq_frac(rho, p, sat):
    """liquid VOLUME fraction of a saturated mix with average density rho"""
    return (rho - sat('rv', p)) / (sat('rl', p) - sat('rv', p))


def u_mix(rho, p, sat):
    """specific internal energy of a saturated mix with average density rho at pressure p"""
    x = (1.0 / rho - 1.0 / sat('rl', p)) / (1.0 / sat('rv', p) - 1.0 / sat('rl', p))
    return sat('ul', p) + x * (sat('uv', p) - sat('ul', p))


def p_from_rho_u(rho, u, S):
    """pressure at which a saturated mix of density rho has specific energy u"""
    x = (1.0 / rho - 1.0 / S['rl']) / (1.0 / S['rv'] - 1.0 / S['rl'])
    ok = (x >= 0) & (x <= 1)
    if np.count_nonzero(ok) < 2:
        return NAN
    um = S['ul'][ok] + x[ok] * (S['uv'][ok] - S['ul'][ok])
    pp = S['p'][ok]
    ix = np.argsort(um)
    return float(np.interp(u, um[ix], pp[ix], left=np.nan, right=np.nan))


def read_eu_csv(file):
    """read EU-CSV (';' separator, ',' decimal); first line = header; numeric columns"""
    with open(file, 'r') as f:
        names = f.readline().strip().split(';')
        rows = [[float(v) for v in line.strip().replace(',', '.').split(';')]
                for line in f if line.strip()]
    X = np.array(rows)
    return {fn(n): X[:, k] for k, n in enumerate(names)}


def fn(name):
    """turn a CSV column name into a valid field name ("T [K]" -> "T__K_")"""
    import re
    f = re.sub(r'[^A-Za-z0-9_]', '_', name.strip())
    if not f or not f[0].isalpha():
        f = 'x' + f
    return f


def ternary(c, a, b):
    return a if c else b


def chk(cond, msg):
    print(f"  [{'PASS' if cond else 'FAIL'}] {msg}")


def okstr(c):
    return 'OK' if c else 'NOT OK'


def cumtrapz(x, y):
    out = np.zeros_like(np.asarray(y, dtype=float))
    out[1:] = np.cumsum(0.5 * (y[1:] + y[:-1]) * np.diff(x))
    return out


